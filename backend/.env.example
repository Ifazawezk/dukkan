# Copy to .env and adjust. All settings use the DUKKAN_ prefix.

# SQLite for local development. For PostgreSQL use:
# DUKKAN_DATABASE_URL=postgresql+psycopg://dukkan:dukkan@localhost:5432/dukkan
DUKKAN_DATABASE_URL=sqlite:///./dukkan.db

# Generate a long random value for anything that is not your laptop, e.g.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
DUKKAN_SECRET_KEY=change-me

# How long a login lasts. 12 hours covers a normal shift.
DUKKAN_ACCESS_TOKEN_MINUTES=720

DUKKAN_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
